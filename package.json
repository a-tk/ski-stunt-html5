{
  "name": "ski-stunt-html5",
  "version": "0.1.0",
  "description": "Ski Stunt Simulator, ported from the Java/AWT demo to JavaScript and HTML5 canvas",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node tools/make-manifest.mjs && node tools/serve.mjs",
    "test": "node --test \"test/**/*.test.js\"",
    "manifest": "node tools/make-manifest.mjs",
    "import-assets": "bash tools/import-assets.sh",
    "smoke": "node tools/smoke.mjs",
    "smoke:editors": "node tools/smoke-editors.mjs",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0"
  }
}
